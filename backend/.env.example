APP_NAME=LogShield
APP_ENV=development
DEBUG=false

DATABASE_URL=postgresql+psycopg2://logshield_user:logshield_password@localhost:5432/logshield_db

JWT_SECRET_KEY=change-this-access-secret-in-production
JWT_REFRESH_SECRET_KEY=change-this-refresh-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080,http://localhost,http://127.0.0.1

RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=20
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_IP_BLOCK_MINUTES=1
ADMIN_2FA_ENABLED=false
ADMIN_SECURITY_EMAIL=
ADMIN_OTP_EXPIRE_MINUTES=5
ADMIN_OTP_MAX_ATTEMPTS=5
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
EMAIL_REQUEST_TIMEOUT_SECONDS=15

# URL Scanner Configuration
URL_REPUTATION_PROVIDER=virustotal
VIRUSTOTAL_API_KEY=
URL_SCAN_CACHE_TTL_HOURS=24
URL_SCAN_RATE_LIMIT_PER_MINUTE=10

# Detection tuning (noise reduction & thresholds)
# DETECTION_TRUSTED_IPS=
# DETECTION_IGNORE_USERNAMES=svc_ci,healthcheck
DETECTION_SLIDING_WINDOW_MINUTES=10
# DETECTION_CORRELATION_WINDOW_MINUTES=15
DETECTION_BRUTE_FORCE_THRESHOLD=5
# DETECTION_HTTP_404_THRESHOLD=5
# DETECTION_SERVER_ERROR_THRESHOLD=8
# DETECTION_SENSITIVE_PATH_HITS_THRESHOLD=3
# DETECTION_MULTI_USER_FAILED_THRESHOLD=3
# DETECTION_CORRELATION_FAILED_LOGINS=3

# High/Critical alert notifications (optional)
# ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...
# ALERT_NOTIFICATION_EMAIL=soc@example.com
