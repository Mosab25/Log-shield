POSTGRES_DB=logshield_db
POSTGRES_USER=logshield_user
POSTGRES_PASSWORD=logshield_password

DATABASE_URL=postgresql+psycopg2://logshield_user:logshield_password@db:5432/logshield_db

JWT_SECRET_KEY=change-this-access-secret-in-production
JWT_REFRESH_SECRET_KEY=change-this-refresh-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://logshield-frontend.onrender.com

RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=20

ROOT_ADMIN_EMAIL=admin@logshield.demo

VITE_API_BASE_URL=http://127.0.0.1:8000

RAPIDAPI_BREACH_KEY=
RAPIDAPI_BREACH_HOST=
RAPIDAPI_BREACH_URL=
RAPIDAPI_BREACH_METHOD=GET
RAPIDAPI_BREACH_EMAIL_PARAM=email
RAPIDAPI_BREACH_EXTRA_QUERY=
